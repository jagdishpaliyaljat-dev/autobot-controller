<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🤖 AutoBot Full Phone Controller"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 1: Grant Permissions"
        android:textColor="#BB86FC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility &amp; Battery Saver"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 2: Choose Automation Target"
        android:textColor="#BB86FC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <RadioGroup
        android:id="@+id/rgTargetApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbYouTube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube"
            android:textColor="#FFFFFF"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbInstagram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instagram"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Schedule Delay (in minutes):"
        android:textColor="#E0E0E0"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etDelayMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:backgroundTint="#BB86FC" />

    <Button
        android:id="@+id/btnScheduleTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚀 Start Scheduled Automation"
        android:backgroundTint="#03DAC5"
        android:textColor="#000000"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Waiting for action..."
        android:textColor="#AAAAAA"
        android:layout_marginTop="16dp" />

</LinearLayout>
