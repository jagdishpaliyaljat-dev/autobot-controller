<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cyber_gradient">

    <!-- Top Chatbot Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#151724">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖"
            android:textSize="26sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AutoBot Copilot"
                android:textColor="#00F5D4"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini 2.0 • Online &amp; Autonomous"
                android:textColor="#7A859E"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Settings / Key Button -->
        <ImageButton
            android:id="@+id/btnToggleSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_card"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#00F5D4" />
    </LinearLayout>

    <!-- Collapsible Settings Panel (API Key & Accessibility) -->
    <LinearLayout
        android:id="@+id/llSettingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1E30"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 Gemini API Key (या OpenRouter Key):"
            android:textColor="#00F5D4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="Gemini API Key (AIzaSy...) ya OpenRouter"
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6482"
            android:textSize="12sp"
            android:inputType="textPassword"
            android:layout_marginTop="6dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_secondary_btn"
            android:text="🛡️ Accessibility &amp; Battery Saver Allow Karo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <!-- Live Floating Execution Status -->
    <TextView
        android:id="@+id/tvExecutionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0B10"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="> AI Copilot Ready. Kuch bhi bolkar kaam karvao."
        android:textColor="#00F5D4"
        android:fontFamily="monospace"
        android:textSize="11sp" />

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Bottom Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#151724">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="46dp"
            android:maxHeight="100dp"
            android:background="@drawable/bg_input_field"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:hint="Bolkar ya likhkar command do (Hindi / English)..."
            android:textColor="#FFFFFF"
            android:textColorHint="#5A6482"
            android:textSize="13sp" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btnSendMessage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_send"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#0D0E15" />
    </LinearLayout>

</LinearLayout>
